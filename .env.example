# Copy to .env for local runs. Never commit the real .env.
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Tried left to right; a retired (404) or rate-limited (429) model falls through to the next.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite,gemini-3.7-flash,gemini-3.6-flash

# Optional tuning
GEMINI_THINKING_LEVEL=low        # Gemini 3.x models
GEMINI_THINKING_BUDGET=1024      # Gemini 2.5 models
LLM_TIMEOUT_SECONDS=60
LLM_TOTAL_BUDGET_SECONDS=80
MAX_UPLOAD_MB=25
